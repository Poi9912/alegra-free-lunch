Table ingredients {
  id integer [pk, unique]
  name varchar(255) [not null, unique]
}

Table ingredients_inventory {
  id integer [pk, unique]
  ingredient_id integer [ref: - ingredients.id]
  quantity integer [default: 0]
}

Table recipes {
  id integer [pk, unique]
  product varchar(255) [not null, unique] 
}

Table recipe_ingredients {
  id integer [pk, unique]
  recipe_id integer [ref: > recipes.id]
  ingredient_id integer [ref: > ingredients.id]
  quantity ingredient [not null, default: 1]
}

Enum order_status {
  created
  confirmed
  cooking
  ready
  delivered
}

Table orders {
  id integer [pk, unique]
  order_number varchar(255) [not null, default: `PENDING NUMBER`] 
  recipe_id integer [ref: > recipes.id, not null] 
  status order_status [not null, default: 'created']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  indexes {
    status [name: 'idx_orders_status']
    (status, created_at) [name: 'idx_orders_status_created']
  }
}

Table inventory_purchase_history {
  id integer [pk, unique]
  ingredient integer [ref: > ingredients.id]
  quantity integer [not null, default: 1]
  purchased_at timestamp [default: `CURRENT_TIMESTAMP`]
}